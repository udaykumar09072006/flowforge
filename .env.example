# -------------------------------------------------------------
# FLOWFORGE ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# PostgreSQL Connection String (Direct or pooled with PgBouncer)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://flowforge:flowforge_password@localhost:5432/flowforge_db?schema=public"

# Redis Queue Connection (BullMQ background execution engine)
# Format: redis://[:PASSWORD@]HOST[:PORT][/DATABASE]
REDIS_URL="redis://localhost:6379"

# Encryption Key for Integration Credentials (AES-256-GCM)
# Must be a secure 32-byte secret (e.g., generated with `openssl rand -hex 32`)
APP_ENCRYPTION_KEY="replace-with-a-secure-32-byte-hex-string-for-aes-256-gcm-encryption"

# JWT Secret for Session and API authentication
JWT_SECRET="replace-with-a-secure-jwt-signing-secret"

# GEMINI_API_KEY: Required for Gemini AI workflow architect.
# In AI Studio, this is automatically injected at runtime from secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Clerk Authentication & RBAC Configuration
# Obtain your Publishable Key and Secret Key from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key_here"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"

# APP_URL / API_BASE_URL: The URL where FlowForge is hosted
APP_URL="http://localhost:3000"
API_BASE_URL="http://localhost:3000/api/v1"

# Port configuration
PORT=3000
